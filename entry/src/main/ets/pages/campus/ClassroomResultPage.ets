import router from '@ohos.router';
@Entry @Component
struct ClassroomResultPage {
  @State private rooms: string[] = ['0410','100207','11101','11103','11105','11A617','11B110','11B201','11B203','11B207','11B208','11B212','11B301','13101'];
  private params: Record<string, string> = {};
  aboutToAppear(): void { this.params = router.getParams() as Record<string, string>; }
  build() { Column() { Row() { Text('‹').fontSize(48).fontColor(Color.White).width(48).onClick(() => router.back()); Text('空教室结果').fontSize(29).fontWeight(FontWeight.Bold).fontColor(Color.White).margin({ left: 18 }); Blank().layoutWeight(1); Text('调整筛选').fontSize(20).fontWeight(FontWeight.Bold).fontColor(Color.White).onClick(() => router.back()); }.width('100%').height(96).padding({ left: 28, right: 28 }).alignItems(VerticalAlign.Center).backgroundColor('#20C894'); Scroll() { Column() { Column() { Text(`${this.rooms.length * 14} 间空教室`).fontSize(32).fontWeight(FontWeight.Bold).fontColor('#203C35').width('100%'); Text('22 个楼栋 / 区域').fontSize(20).fontColor('#65736F').width('100%').margin({ top: 10 }); Text(`第 ${this.params.startWeek || '1'} 周 · ${this.params.weekday || '周一'} · 第 ${this.params.startPeriod || '1'} 节`).fontSize(18).fontWeight(FontWeight.Bold).fontColor('#168C68').width('100%').padding(18).backgroundColor('#E8F7F0').borderRadius(18).margin({ top: 24 }); }.width('100%').padding(26).backgroundColor(Color.White); Column() { Row() { Text('其他教室').fontSize(25).fontWeight(FontWeight.Bold).fontColor('#203C35'); Blank().layoutWeight(1); Text(`${this.rooms.length} 间`).fontSize(18).fontColor('#65736F'); }.width('100%').margin({ bottom: 18 }); Grid() { ForEach(this.rooms, (room: string) => GridItem() { Text(room).fontSize(25).fontWeight(FontWeight.Bold).fontColor('#203C35').textAlign(TextAlign.Center).width('100%').height(108).backgroundColor(Color.White).borderRadius(22); }, (room: string) => room); }.columnsTemplate('1fr 1fr').columnsGap(18).rowsGap(18); }.width('100%').padding(26).backgroundColor('#F5F6F8'); }.width('100%'); }.layoutWeight(1).scrollBar(BarState.Off); }.width('100%').height('100%').backgroundColor('#F5F6F8'); }
}
