import router from '@ohos.router';
import { promptAction } from '@kit.ArkUI';
import { CampusWallApi, CampusWallPost, CampusWallReply, decodeHtmlEntities } from '../../net/CampusWallApi';
@Entry @Component
struct CampusPostDetailPage {
  @State private postId: number = 0; @State private post: CampusWallPost = {}; @State private replyText: string = ''; @State private loading: boolean = true;
  aboutToAppear(): void { const params = router.getParams() as Record<string, string>; this.postId = Number(params?.['id'] || 0); this.load(); }
  private async load(): Promise<void> { try { this.post = await CampusWallApi.detail(this.postId); } catch { promptAction.showToast({ message: '详情加载失败', duration: 1500 }); } this.loading = false; }
  private async submitReply(): Promise<void> { if (this.postId <= 0 || this.replyText.trim().length === 0) { promptAction.showToast({ message: '请输入回复内容', duration: 1200 }); return; } try { await CampusWallApi.reply(this.postId, this.replyText.trim()); this.replyText = ''; await this.load(); } catch { promptAction.showToast({ message: '回复失败，请稍后重试', duration: 1500 }); } }
  private dateLabel(value: string | undefined): string { if (!value) return ''; const stamp = Date.parse(value); return isNaN(stamp) ? value : new Date(stamp).toLocaleString(); }
  build() { Column() { Row() { Text('‹').fontSize(42).width(48).onClick(() => router.back()); Text('详情').fontSize(28).fontWeight(FontWeight.Bold).margin({ left: 12 }); Blank().layoutWeight(1); Image($r('app.media.more_horiz')).width(28).height(28); }.width('100%').height(76).padding({ left: 14, right: 24 }).backgroundColor('#F5F6F8'); Scroll() { Column() { if (this.loading) { Text('加载中…').fontSize(18).fontColor('#999999'); } else { Column() { Text(decodeHtmlEntities(this.post.title || '')).fontSize(23).fontWeight(FontWeight.Bold); Text(decodeHtmlEntities(this.post.content || '')).fontSize(19).fontColor('#444444').margin({ top: 16 }); }.width('100%').padding(28).backgroundColor(Color.White); Text('回复').fontSize(22).fontWeight(FontWeight.Bold).width('100%').padding({ left: 34, top: 20, bottom: 16 }); ForEach(this.post.replies || [], (reply: CampusWallReply) => Row() { Image(reply.avatarUrl || $r('app.media.ic_default_avatar')).width(52).height(52).borderRadius(26).margin({ right: 14 }); Column() { Row() { Text(reply.displayName || reply.realName || '同学').fontSize(19).fontWeight(FontWeight.Bold).fontColor('#655C86').layoutWeight(1); Image($r('app.media.more_horiz')).width(24).height(24); }.width('100%'); Text(reply.college || reply.major || '').fontSize(15).fontColor('#888888'); Text(decodeHtmlEntities(reply.content || '')).fontSize(19).margin({ top: 16 }); Text(this.dateLabel(reply.createdAt)).fontSize(15).fontColor('#AAAAAA').margin({ top: 14 }); }.layoutWeight(1); }.width('100%').padding({ left: 40, right: 34, top: 20, bottom: 24 }).backgroundColor(Color.White), (reply: CampusWallReply) => `${reply.id || reply.createdAt}`); } }.width('100%').backgroundColor('#F5F6F8'); }.layoutWeight(1); Row() { TextInput({ placeholder: '说点什么吧...', text: this.replyText }).layoutWeight(1).fontSize(18).onChange((value: string) => { this.replyText = value; }); Button('发送').fontColor(Color.White).backgroundColor('#20C894').borderRadius(22).onClick(() => this.submitReply()); }.width('92%').height(64).padding(10).backgroundColor(Color.White).borderRadius(32).margin({ bottom: 16 }); }.width('100%').height('100%').backgroundColor('#F5F6F8'); }
}
