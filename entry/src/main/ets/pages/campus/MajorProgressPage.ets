import router from '@ohos.router';
import { promptAction } from '@kit.ArkUI';
import { TrainingPlanApi, TrainingPlanSummary } from '../../net/TrainingPlanApi';
@Entry @Component struct MajorProgressPage {
  @State private data: TrainingPlanSummary = { credits: 0, courseCount: 0, failedCount: 0, missingRequired: 0, missingCredits: 0, categories: 0, planCourseCount: 0 }; @State private loading: boolean = true;
  aboutToAppear(): void { this.load(); } private async load(): Promise<void> { try { this.data = await TrainingPlanApi.fetchSummary(); } catch { promptAction.showToast({ message: '培养方案加载失败', duration: 1500 }); } this.loading = false; }
  build() { Column() { Row() { Text('‹').fontSize(44).fontColor(Color.White).width(48).textAlign(TextAlign.Center).onClick(() => router.back()); Text('主修进度').fontSize(28).fontWeight(FontWeight.Bold).fontColor(Color.White).margin({ left: 18 }); Blank().layoutWeight(1); Text('↻').fontSize(36).fontColor(Color.White).onClick(() => this.load()); }.width('100%').height(88).padding({ left: 14, right: 24 }).backgroundColor('#20C894'); Scroll() { Column() { Column() { Text('已修学分').fontSize(21).fontWeight(FontWeight.Bold).fontColor('#666666'); Text(this.loading ? '加载中' : `${this.data.credits}分`).fontSize(46).fontWeight(FontWeight.Bold).fontColor('#20C894').margin({ top: 22 }); Text(`课程 ${this.data.courseCount} 门 · 不及格 ${this.data.failedCount} 门 · 必修未获 ${this.data.missingRequired} 门`).fontSize(18).fontWeight(FontWeight.Bold).fontColor('#555555').margin({ top: 24 }); Text(this.data.missingRequired > 0 || this.data.missingCredits > 0 ? '学习进度落后：存在落后于培养方案的未获学分课程。' : '学习进度正常：当前培养方案要求均已满足。').fontSize(18).fontWeight(FontWeight.Bold).fontColor('#D94A43').margin({ top: 16 }); }.width('100%').padding(28).backgroundColor(Color.White).borderRadius(24); Column() { Text('完成概览').fontSize(24).fontWeight(FontWeight.Bold).width('100%'); Row() { this.stat(`${this.data.courseCount}门`, '已修课程'); this.stat(`${this.data.failedCount}门`, '不及格'); }.width('100%').margin({ top: 28 }); Row() { this.stat(`${this.data.missingRequired}门`, '必修未获'); this.stat(`${this.data.missingCredits}分`, '未选学分'); }.width('100%').margin({ top: 24 }); }.width('100%').padding(28).backgroundColor(Color.White).borderRadius(24).margin({ top: 16 }); Column() { Text('查看明细').fontSize(24).fontWeight(FontWeight.Bold).width('100%'); this.detail('课程统计', '学期、已修、不及格、未选和必修未获统计', `${this.data.courseCount} 门`); this.detail('毕业学分完成情况', '按课程性质展示要求学分和已获学分', `${this.data.categories} 个类别`); this.detail('通识选修类别', '按通识类别展示要求学分和已获学分', `${this.data.categories} 个类别`); this.detail('培养方案课程明细', '按学期分组查看每门课的修读状态', `${this.data.planCourseCount} 门课程`); }.width('100%').padding(28).backgroundColor(Color.White).borderRadius(24).margin({ top: 16 }); }.width('100%').padding(16).backgroundColor('#F5F6F7'); }.layoutWeight(1); }.width('100%').height('100%').backgroundColor('#F5F6F7'); }
  @Builder private stat(value: string, label: string): void { Column() { Text(value).fontSize(34).fontWeight(FontWeight.Bold).fontColor('#20C894'); Text(label).fontSize(17).fontColor('#777777').margin({ top: 4 }); }.width('50%').alignItems(HorizontalAlign.Start); }
  @Builder private detail(title: string, desc: string, value: string): void { Row() { Column() { Text(title).fontSize(20).fontWeight(FontWeight.Bold).fontColor('#666666'); Text(desc).fontSize(16).fontColor('#888888').margin({ top: 7 }); }.alignItems(HorizontalAlign.Start).layoutWeight(1); Text(`${value}  >`).fontSize(18).fontWeight(FontWeight.Bold).fontColor('#20C894'); }.width('100%').margin({ top: 28 }); }
}
