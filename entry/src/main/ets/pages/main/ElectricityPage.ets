import router from '@ohos.router';
import { promptAction } from '@kit.ArkUI';
import { ElectricityApi, YKTLocationItem } from '../../net/ElectricityApi';
@Entry @Component
struct ElectricityPage {
  @State private level: number = 0; @State private loading: boolean = false; @State private locations: YKTLocationItem[] = []; @State private selected: YKTLocationItem[] = []; @State private result: string = ''; @State private unit: string = '';
  aboutToAppear(): void { this.loadLocations(''); }
  private async loadLocations(parentId: string): Promise<void> { this.loading = true; try { const page = await ElectricityApi.locations(parentId); this.locations = page.items || []; } catch { promptAction.showToast({ message: '地点加载失败，请稍后重试', duration: 1500 }); } this.loading = false; }
  private choose(item: YKTLocationItem): void { const next = this.selected.slice(0, this.level); next.push(item); this.selected = next; this.result = ''; if (this.level < 2) { this.level += 1; this.loadLocations(item.id); } else { this.level = 3; } }
  private async query(): Promise<void> { const room = this.selected[2]; if (!room) { promptAction.showToast({ message: '请选择房间', duration: 1200 }); return; } this.loading = true; try { const data = await ElectricityApi.electricity(room.id); this.result = data.remaining; this.unit = data.unit; } catch { promptAction.showToast({ message: '电费查询失败，请稍后重试', duration: 1500 }); } this.loading = false; }
  build() { Column() { Row() { Text('‹').fontSize(42).width(48).onClick(() => router.back()); Text('查电费').fontSize(28).fontWeight(FontWeight.Bold).margin({ left: 12 }); }.width('100%').height(76).padding({ left: 14 }).backgroundColor('#F5F6F8'); Scroll() { Column() { Text('一卡通电费查询').fontSize(25).fontWeight(FontWeight.Bold).width('92%').margin({ top: 24, bottom: 18 }); Row() { ForEach(this.selected, (item: YKTLocationItem, index: number) => Text(item.name).fontSize(16).fontColor(index === this.level - 1 ? '#B26E2A' : '#777777').margin({ right: 8 })); }.width('92%').margin({ bottom: 18 }); if (this.loading) { Text('加载中…').fontSize(18).fontColor('#999999').margin({ top: 30 }); } else if (this.level < 3) { Text(this.level === 0 ? '请选择校区' : this.level === 1 ? '请选择楼栋' : '请选择房间').fontSize(18).fontColor('#777777').width('92%').margin({ bottom: 8 }); ForEach(this.locations, (item: YKTLocationItem) => Row() { Text(item.name).fontSize(19).fontColor('#333333').layoutWeight(1); Text('›').fontSize(28).fontColor('#999999'); }.width('92%').height(62).padding({ left: 18, right: 18 }).backgroundColor(Color.White).borderRadius(12).margin({ top: 10 }).onClick(() => this.choose(item)), (item: YKTLocationItem) => item.id); } else { Text(`房间：${this.selected[2]?.name || ''}`).fontSize(20).fontWeight(FontWeight.Bold).width('92%').margin({ top: 20 }); Button('查询剩余电费').width('88%').height(52).fontSize(18).fontColor(Color.White).backgroundColor('#20C894').borderRadius(26).margin({ top: 24 }).onClick(() => this.query()); if (this.result) { Text(`${this.result} ${this.unit}`).fontSize(36).fontWeight(FontWeight.Bold).fontColor('#B26E2A').margin({ top: 36 }); } Text('重新选择').fontSize(17).fontColor('#20C894').margin({ top: 24 }).onClick(() => { this.selected = []; this.level = 0; this.result = ''; this.loadLocations(''); }); } }.width('100%').padding({ bottom: 30 }).backgroundColor('#F5F6F8'); }.layoutWeight(1); }.width('100%').height('100%').backgroundColor('#F5F6F8'); }
}
